# ============================================================
# Gezerce – Ortam Değişkenleri
# Bu dosyayı .env.local olarak kopyalayın ve değerleri doldurun.
# .env.local Git'e gönderilmez (gitignore'da).
# ============================================================

# ------ Firebase ------
# https://console.firebase.google.com → Proje Ayarları → Web Uygulaması
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_VAPID_KEY=

# ------ Google APIs ------
# https://console.cloud.google.com → APIs & Services → Credentials
# Etkinleştirin: Maps JavaScript API, Places API, Directions API
# HTTP referrer kısıtlaması ZORUNLU (güvenlik için)
VITE_GOOGLE_MAPS_API_KEY=

# ------ OpenWeatherMap ------
# https://openweathermap.org/api → Ücretsiz API anahtarı alın
VITE_OPENWEATHER_API_KEY=

# ------ Claude / Anthropic ------
# https://console.anthropic.com → API Keys
# ÜRETİMDE: Bu anahtarı doğrudan kullanmayın!
# Firebase Cloud Function veya Vercel Edge Function ile proxy oluşturun.
# Geliştirme ortamında direkt kullanılabilir.
VITE_CLAUDE_API_KEY=

# ------ Uygulama ------
VITE_APP_URL=http://localhost:5173
VITE_APP_VERSION=0.1.0
